# Copy to .env for local development. Do not put real secrets in git.
# Only VITE_-prefixed values reach the browser, so nothing secret belongs here.

# stackr-api base URL. Leave empty to force demo mode with mock data.
VITE_API_URL=

# Sign in against a locally running `pnpm dev:sandbox` API, which has auth
# disabled and identifies the caller by email. Never set for a deployed build.
VITE_API_SANDBOX=

# When true, production builds still offer demo mode even if VITE_API_URL is set.
VITE_ALLOW_DEMO=

# Supabase Auth (anon key only — the service role key lives in stackr-api)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vercel CLI (local deploys only — never prefix with VITE_)
VERCEL_TOKEN=
